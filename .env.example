# Copy to .env, which is ignored by git. Every variable compose.yaml reads is
# listed here, and all of them are required. The values below are for a
# database and storage that only listen on this machine; change the passwords
# before exposing either of them to anything else.

# The provider keys at the bottom are the exception: compose.yaml does not read
# them, and they are only needed for the provider test.

# PostgreSQL
POSTGRES_DB=affivideo
POSTGRES_USER=affivideo
POSTGRES_PASSWORD=local-only-change-me

# Object storage (MinIO). The password must be at least 8 characters.
MINIO_ROOT_USER=affivideo
MINIO_ROOT_PASSWORD=local-only-change-me
STORAGE_BUCKET=affivideo

# What generates pictures for Hybrid videos. None: nothing is generated, a
# Hybrid Variant is planned as a Product Lock one, and generation says it is
# unavailable. Fake: a fixed striped picture that calls no provider and charges
# nobody, labelled as fake wherever it is shown. There is no real provider yet.
# This one is not required: without it, None.
IMAGE_PROVIDER=None

# Ports published on 127.0.0.1. Change one if it is already taken.
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Provider test (prototypes/provider-test). These cost real money when used.
# Never commit a key.

# fal.ai, for Stills and Clips. Required for the stills and clips commands.
FAL_KEY=

# Speech. Each is optional; a provider without a key is skipped.
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# Optional: comma-separated ElevenLabs voice ids to try. Without it, the
# first two voices of the account are used.
ELEVENLABS_VOICE_IDS=
