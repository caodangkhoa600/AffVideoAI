# Copy to .env, which is ignored by git. Every variable compose.yaml reads is
# listed here, and all of them are required. The values below are for a
# database and storage that only listen on this machine; change the passwords
# before exposing either of them to anything else.

# PostgreSQL
POSTGRES_DB=affivideo
POSTGRES_USER=affivideo
POSTGRES_PASSWORD=local-only-change-me

# Object storage (MinIO). The password must be at least 8 characters.
MINIO_ROOT_USER=affivideo
MINIO_ROOT_PASSWORD=local-only-change-me
STORAGE_BUCKET=affivideo

# Ports published on 127.0.0.1. Change one if it is already taken.
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
